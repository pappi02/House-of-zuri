generator client {
  provider        = "prisma-client-js"
  previewFeatures = ["multiSchema"]
}

datasource db {
  provider  = "postgresql"
  url       = env("DATABASE_URL")
  directUrl = env("DIRECT_URL")
  schemas   = ["catalog", "customer", "fulfillment", "identity", "inventory", "manufacturing", "orders", "payments"]
}

model Customer {
  id             String           @id @default(dbgenerated("uuid_generate_v4()")) @db.Uuid
  email          String           @unique @map("email") @db.VarChar(255)
  phone          String?          @map("phone") @db.VarChar(30)
  name           String?
  createdAt      DateTime?        @default(now()) @map("created_at") @db.Timestamp(6)
  updatedAt      DateTime?        @default(now()) @updatedAt @map("updated_at") @db.Timestamp(6)
  accountId      String?          @map("account_id") @db.Uuid
  customerNumber String?          @unique(map: "idx_customers_customer_number") @default(dbgenerated("('CUS-'::text || lpad((nextval('customer.customer_number_seq'::regclass))::text, 6, '0'::text))")) @map("customer_number") @db.VarChar(30)
  firstName      String?          @map("first_name") @db.VarChar(100)
  middleName     String?          @map("middle_name") @db.VarChar(100)
  lastName       String?          @map("last_name") @db.VarChar(100)
  preferredName  String?          @map("preferred_name") @db.VarChar(100)
  isGuest        Boolean?         @default(true) @map("is_guest")
  status         customer_status? @default(ACTIVE) @map("status")
  marketingOptIn Boolean?         @default(false) @map("marketing_opt_in")
  notes          String?          @map("notes")

  @@index([accountId], map: "idx_customers_account_id")
  @@index([email], map: "idx_customers_email")
  @@index([phone], map: "idx_customers_phone")
  @@map("customers")
  @@schema("customer")
}

model Category {
  id          String     @id @default(dbgenerated("uuid_generate_v4()")) @db.Uuid
  parentId    String?    @map("parent_id") @db.Uuid
  name        String     @db.VarChar(255)
  slug        String     @unique @db.VarChar(255)
  description String?
  imageUrl    String?    @map("image_url") @db.VarChar(500)
  sortOrder   Int        @default(0) @map("sort_order")
  isActive    Boolean    @default(true) @map("is_active")
  createdAt   DateTime   @default(now()) @map("created_at") @db.Timestamp(6)
  updatedAt   DateTime   @default(now()) @updatedAt @map("updated_at") @db.Timestamp(6)
  parent      Category?  @relation("CategoryHierarchy", fields: [parentId], references: [id], onUpdate: NoAction)
  children    Category[] @relation("CategoryHierarchy")
  products    Product[]

  @@index([isActive], map: "idx_categories_is_active")
  @@index([parentId], map: "idx_categories_parent_id")
  @@index([slug], map: "idx_categories_slug")
  @@map("categories")
  @@schema("catalog")
}

model Collection {
  id          String    @id @default(dbgenerated("uuid_generate_v4()")) @db.Uuid
  name        String    @db.VarChar(255)
  slug        String    @unique @db.VarChar(255)
  description String?
  imageUrl    String?   @map("image_url") @db.VarChar(500)
  isActive    Boolean   @default(true) @map("is_active")
  sortOrder   Int       @default(0) @map("sort_order")
  createdAt   DateTime  @default(now()) @map("created_at") @db.Timestamp(6)
  updatedAt   DateTime  @default(now()) @updatedAt @map("updated_at") @db.Timestamp(6)
  products    Product[]

  @@index([isActive], map: "idx_collections_is_active")
  @@index([slug], map: "idx_collections_slug")
  @@map("collections")
  @@schema("catalog")
}

model Size {
  id        String           @id @default(dbgenerated("uuid_generate_v4()")) @db.Uuid
  name      String           @unique @db.VarChar(50)
  code      String           @unique @db.VarChar(10)
  sortOrder Int              @default(0) @map("sort_order")
  isActive  Boolean          @default(true) @map("is_active")
  createdAt DateTime         @default(now()) @map("created_at") @db.Timestamp(6)
  updatedAt DateTime         @default(now()) @updatedAt @map("updated_at") @db.Timestamp(6)
  variants  ProductVariant[]

  @@index([code], map: "idx_sizes_code")
  @@index([isActive], map: "idx_sizes_is_active")
  @@map("sizes")
  @@schema("catalog")
}

model Color {
  id        String           @id @default(dbgenerated("uuid_generate_v4()")) @db.Uuid
  name      String           @unique @db.VarChar(100)
  hexCode   String?          @map("hex_code") @db.VarChar(7)
  sortOrder Int              @default(0) @map("sort_order")
  isActive  Boolean          @default(true) @map("is_active")
  createdAt DateTime         @default(now()) @map("created_at") @db.Timestamp(6)
  updatedAt DateTime         @default(now()) @updatedAt @map("updated_at") @db.Timestamp(6)
  variants  ProductVariant[]

  @@index([isActive], map: "idx_colors_is_active")
  @@index([name], map: "idx_colors_name")
  @@map("colors")
  @@schema("catalog")
}

model Product {
  id                      String           @id @default(dbgenerated("uuid_generate_v4()")) @db.Uuid
  productNumber           String           @unique @default(dbgenerated("('PRD-'::text || lpad((nextval('catalog.product_number_seq'::regclass))::text, 6, '0'::text))")) @map("product_number") @db.VarChar(30)
  name                    String           @db.VarChar(255)
  slug                    String           @unique @db.VarChar(255)
  description             String?
  shortDescription        String?          @map("short_description")
  categoryId              String           @map("category_id") @db.Uuid
  collectionId            String?          @map("collection_id") @db.Uuid
  productType             product_type     @default(READY_MADE) @map("product_type")
  status                  product_status   @default(DRAFT) @map("status")
  basePrice               Decimal          @map("base_price") @db.Decimal(12, 2)
  currency                String           @default("USD") @db.VarChar(3)
  featured                Boolean          @default(false)
  newArrival              Boolean          @default(false) @map("new_arrival")
  careInstructions        String?          @map("care_instructions")
  estimatedProductionDays Int?             @map("estimated_production_days")
  seoTitle                String?          @map("seo_title") @db.VarChar(255)
  seoDescription          String?          @map("seo_description")
  createdAt               DateTime         @default(now()) @map("created_at") @db.Timestamp(6)
  updatedAt               DateTime         @default(now()) @updatedAt @map("updated_at") @db.Timestamp(6)
  images                  ProductImage[]
  variants                ProductVariant[]
  category                Category         @relation(fields: [categoryId], references: [id], onUpdate: NoAction)
  collection              Collection?      @relation(fields: [collectionId], references: [id], onUpdate: NoAction)

  @@index([categoryId], map: "idx_products_category_id")
  @@index([collectionId], map: "idx_products_collection_id")
  @@index([featured], map: "idx_products_featured")
  @@index([newArrival], map: "idx_products_new_arrival")
  @@index([productNumber], map: "idx_products_product_number")
  @@index([productType], map: "idx_products_product_type")
  @@index([slug], map: "idx_products_slug")
  @@index([status], map: "idx_products_status")
  @@map("products")
  @@schema("catalog")
}

model ProductVariant {
  id            String   @id @default(dbgenerated("uuid_generate_v4()")) @db.Uuid
  productId     String   @map("product_id") @db.Uuid
  sku           String   @unique @db.VarChar(100)
  colorId       String   @map("color_id") @db.Uuid
  sizeId        String   @map("size_id") @db.Uuid
  priceOverride Decimal? @map("price_override") @db.Decimal(12, 2)
  weightGrams   Int?     @map("weight_grams")
  barcode       String?  @db.VarChar(100)
  isActive      Boolean  @default(true) @map("is_active")
  sortOrder     Int      @default(0) @map("sort_order")
  createdAt     DateTime @default(now()) @map("created_at") @db.Timestamp(6)
  updatedAt     DateTime @default(now()) @updatedAt @map("updated_at") @db.Timestamp(6)
  color         Color    @relation(fields: [colorId], references: [id], onUpdate: NoAction)
  product       Product  @relation(fields: [productId], references: [id], onDelete: Cascade, onUpdate: NoAction)
  size          Size     @relation(fields: [sizeId], references: [id], onUpdate: NoAction)

  @@unique([productId, colorId, sizeId])
  @@index([colorId], map: "idx_product_variants_color_id")
  @@index([isActive], map: "idx_product_variants_is_active")
  @@index([productId], map: "idx_product_variants_product_id")
  @@index([sizeId], map: "idx_product_variants_size_id")
  @@index([sku], map: "idx_product_variants_sku")
  @@map("product_variants")
  @@schema("catalog")
}

model ProductImage {
  id           String   @id @default(dbgenerated("uuid_generate_v4()")) @db.Uuid
  productId    String   @map("product_id") @db.Uuid
  storagePath  String   @map("storage_path") @db.VarChar(500)
  publicUrl    String   @map("public_url") @db.VarChar(500)
  altText      String?  @map("alt_text") @db.VarChar(255)
  displayOrder Int      @default(0) @map("display_order")
  isPrimary    Boolean  @default(false) @map("is_primary")
  createdAt    DateTime @default(now()) @map("created_at") @db.Timestamp(6)
  updatedAt    DateTime @default(now()) @updatedAt @map("updated_at") @db.Timestamp(6)
  product      Product  @relation(fields: [productId], references: [id], onDelete: Cascade, onUpdate: NoAction)

  @@index([isPrimary], map: "idx_product_images_is_primary")
  @@index([productId], map: "idx_product_images_product_id")
  @@map("product_images")
  @@schema("catalog")
}

model dispatch_records {
  id              String        @id @default(dbgenerated("gen_random_uuid()")) @db.Uuid
  fulfillment_id  String?       @db.Uuid
  carrier         String?
  tracking_number String?
  dispatched_at   DateTime      @default(now()) @db.Timestamptz(6)
  fulfillments    fulfillments? @relation(fields: [fulfillment_id], references: [id], onDelete: Cascade, onUpdate: NoAction)

  @@schema("fulfillment")
}

model fulfillment_items {
  id             String        @id @default(dbgenerated("gen_random_uuid()")) @db.Uuid
  fulfillment_id String?       @db.Uuid
  order_item_id  String        @db.Uuid
  product_id     String        @db.Uuid
  variant_id     String?       @db.Uuid
  quantity       Int
  status         String        @default("PENDING")
  created_at     DateTime?     @default(now()) @db.Timestamptz(6)
  updated_at     DateTime?     @default(now()) @db.Timestamptz(6)
  fulfillments   fulfillments? @relation(fields: [fulfillment_id], references: [id], onDelete: Cascade, onUpdate: NoAction)

  @@schema("fulfillment")
}

model fulfillment_timelines {
  id             String        @id @default(dbgenerated("gen_random_uuid()")) @db.Uuid
  fulfillment_id String?       @db.Uuid
  event          String
  metadata       Json?
  created_at     DateTime      @default(now()) @db.Timestamptz(6)
  fulfillments   fulfillments? @relation(fields: [fulfillment_id], references: [id], onDelete: Cascade, onUpdate: NoAction)

  @@schema("fulfillment")
}

model fulfillments {
  id                    String                  @id @default(dbgenerated("gen_random_uuid()")) @db.Uuid
  fulfillment_number    String?                 @unique
  order_id              String                  @db.Uuid
  status                String
  packing_slip_id       String?                 @db.Uuid
  dispatch_record_id    String?                 @db.Uuid
  created_at            DateTime?               @default(now()) @db.Timestamptz(6)
  updated_at            DateTime?               @default(now()) @db.Timestamptz(6)
  dispatch_records      dispatch_records[]
  fulfillment_items     fulfillment_items[]
  fulfillment_timelines fulfillment_timelines[]
  packing_slips         packing_slips[]

  @@schema("fulfillment")
}

model packing_slips {
  id             String        @id @default(dbgenerated("gen_random_uuid()")) @db.Uuid
  fulfillment_id String?       @db.Uuid
  slip_number    String?       @unique
  items          Json
  generated_at   DateTime      @default(now()) @db.Timestamptz(6)
  fulfillments   fulfillments? @relation(fields: [fulfillment_id], references: [id], onDelete: Cascade, onUpdate: NoAction)

  @@schema("fulfillment")
}

model inventory_items {
  id                  String                @id @db.Uuid
  inventory_number    String                @unique @db.VarChar(50)
  product_id          String                @db.Uuid
  variant_id          String                @db.Uuid
  sku                 String?               @db.VarChar(255)
  on_hand             Int                   @default(0)
  reserved            Int                   @default(0)
  minimum_stock       Int?
  maximum_stock       Int?
  reorder_level       Int?
  status              String?               @db.VarChar(50)
  location            String?               @db.VarChar(255)
  created_at          DateTime              @default(now()) @db.Timestamptz(6)
  updated_at          DateTime              @default(now()) @db.Timestamptz(6)
  inventory_movements inventory_movements[]
  stock_reservations  stock_reservations[]

  @@schema("inventory")
}

model inventory_movements {
  id                String          @id @db.Uuid
  inventory_item_id String          @db.Uuid
  type              String          @db.VarChar(50)
  quantity          Int
  reason            String?
  created_at        DateTime        @default(now()) @db.Timestamptz(6)
  inventory_items   inventory_items @relation(fields: [inventory_item_id], references: [id], onDelete: Cascade, onUpdate: NoAction)

  @@schema("inventory")
}

model stock_reservations {
  id                String          @id @db.Uuid
  order_id          String          @db.Uuid
  order_item_id     String          @db.Uuid
  inventory_item_id String          @db.Uuid
  quantity          Int
  status            String          @db.VarChar(50)
  expires_at        DateTime?       @db.Timestamptz(6)
  created_at        DateTime        @default(now()) @db.Timestamptz(6)
  inventory_items   inventory_items @relation(fields: [inventory_item_id], references: [id], onDelete: Cascade, onUpdate: NoAction)

  @@schema("inventory")
}

model manufacturing_jobs {
  id           String        @id @default(dbgenerated("gen_random_uuid()")) @db.Uuid
  job_number   String?       @unique
  order_id     String        @db.Uuid
  status       String?
  priority     Int?
  started_at   DateTime?     @db.Timestamptz(6)
  completed_at DateTime?     @db.Timestamptz(6)
  created_at   DateTime?     @default(now()) @db.Timestamptz(6)
  updated_at   DateTime?     @default(now()) @db.Timestamptz(6)
  work_orders  work_orders[]

  @@schema("manufacturing")
}

model measurements {
  id            String       @id @default(dbgenerated("gen_random_uuid()")) @db.Uuid
  work_order_id String?      @db.Uuid
  bust          Decimal?     @db.Decimal
  waist         Decimal?     @db.Decimal
  hip           Decimal?     @db.Decimal
  shoulder      Decimal?     @db.Decimal
  sleeve        Decimal?     @db.Decimal
  height        Decimal?     @db.Decimal
  inseam        Decimal?     @db.Decimal
  notes         String?
  created_at    DateTime?    @default(now()) @db.Timestamptz(6)
  work_orders   work_orders? @relation(fields: [work_order_id], references: [id], onDelete: Cascade, onUpdate: NoAction)

  @@schema("manufacturing")
}

model quality_inspections {
  id            String       @id @default(dbgenerated("gen_random_uuid()")) @db.Uuid
  work_order_id String?      @db.Uuid
  status        String?
  notes         String?
  inspected_by  String?      @db.Uuid
  inspected_at  DateTime?    @db.Timestamptz(6)
  created_at    DateTime?    @default(now()) @db.Timestamptz(6)
  work_orders   work_orders? @relation(fields: [work_order_id], references: [id], onDelete: Cascade, onUpdate: NoAction)

  @@schema("manufacturing")
}

model timeline {
  id            String       @id @default(dbgenerated("gen_random_uuid()")) @db.Uuid
  work_order_id String?      @db.Uuid
  event         String
  metadata      Json?
  created_at    DateTime?    @default(now()) @db.Timestamptz(6)
  work_orders   work_orders? @relation(fields: [work_order_id], references: [id], onDelete: Cascade, onUpdate: NoAction)

  @@schema("manufacturing")
}

model work_orders {
  id                        String                @id @default(dbgenerated("gen_random_uuid()")) @db.Uuid
  work_order_number         String?               @unique
  manufacturing_job_id      String?               @db.Uuid
  order_item_id             String?               @db.Uuid
  product_id                String?               @db.Uuid
  variant_id                String?               @db.Uuid
  assigned_tailor_id        String?               @db.Uuid
  status                    String?
  estimated_completion_date DateTime?             @db.Timestamptz(6)
  completed_at              DateTime?             @db.Timestamptz(6)
  created_at                DateTime?             @default(now()) @db.Timestamptz(6)
  updated_at                DateTime?             @default(now()) @db.Timestamptz(6)
  measurements              measurements[]
  quality_inspections       quality_inspections[]
  timeline                  timeline[]
  manufacturing_jobs        manufacturing_jobs?   @relation(fields: [manufacturing_job_id], references: [id], onDelete: Cascade, onUpdate: NoAction)

  @@schema("manufacturing")
}

model order_items {
  id                    String    @id @default(dbgenerated("gen_random_uuid()")) @db.Uuid
  order_id              String?   @db.Uuid
  product_id            String    @db.Uuid
  variant_id            String?   @db.Uuid
  product_name          String?
  quantity              Int
  unit_price            Decimal   @db.Decimal(12, 2)
  product_type          String?
  requires_measurements Boolean?  @default(false)
  created_at            DateTime? @default(now()) @db.Timestamptz(6)
  updated_at            DateTime? @default(now()) @db.Timestamptz(6)
  orders                orders?   @relation(fields: [order_id], references: [id], onDelete: Cascade, onUpdate: NoAction)

  @@schema("orders")
}

model order_timelines {
  id         String    @id @default(dbgenerated("gen_random_uuid()")) @db.Uuid
  order_id   String?   @db.Uuid
  event      String
  metadata   Json?
  created_at DateTime? @default(now()) @db.Timestamptz(6)
  orders     orders?   @relation(fields: [order_id], references: [id], onDelete: Cascade, onUpdate: NoAction)

  @@schema("orders")
}

model orders {
  id              String            @id @default(dbgenerated("gen_random_uuid()")) @db.Uuid
  order_number    String?           @unique
  customer_id     String?           @db.Uuid
  guest_email     String?
  guest_phone     String?
  currency        String            @default("USD")
  status          String            @default("PENDING")
  notes           String?
  total_amount    Decimal?          @default(0) @db.Decimal(12, 2)
  created_at      DateTime?         @default(now()) @db.Timestamptz(6)
  updated_at      DateTime?         @default(now()) @db.Timestamptz(6)
  order_items     order_items[]
  order_timelines order_timelines[]

  @@schema("orders")
}

model outbox_events {
  id             String    @id @db.Uuid
  aggregate_type String    @db.VarChar(100)
  aggregate_id   String    @db.VarChar(100)
  event_type     String    @db.VarChar(100)
  payload        Json
  created_at     DateTime  @default(now()) @db.Timestamptz(6)
  published_at   DateTime? @db.Timestamptz(6)

  @@schema("payments")
}

model payment_attempts {
  id                String   @id @db.Uuid
  payment_id        String   @db.Uuid
  attempt_number    Int
  gateway_reference String?  @db.VarChar(255)
  status            String   @db.VarChar(50)
  request_payload   Json?
  response_payload  Json?
  created_at        DateTime @default(now()) @db.Timestamptz(6)
  payments          payments @relation(fields: [payment_id], references: [id], onDelete: Cascade, onUpdate: NoAction)

  @@schema("payments")
}

model payment_events {
  id         String   @id @db.Uuid
  payment_id String   @db.Uuid
  event_type String   @db.VarChar(100)
  payload    Json?
  created_at DateTime @default(now()) @db.Timestamptz(6)
  payments   payments @relation(fields: [payment_id], references: [id], onDelete: Cascade, onUpdate: NoAction)

  @@schema("payments")
}

model payments {
  id                      String             @id @db.Uuid
  payment_number          String             @unique @db.VarChar(50)
  order_id                String             @db.Uuid
  customer_id             String?            @db.Uuid
  gateway                 String             @db.VarChar(50)
  currency                String             @default("USD") @db.VarChar(10)
  amount                  Decimal            @db.Decimal(12, 2)
  status                  String             @db.VarChar(50)
  gateway_reference       String?            @db.VarChar(255)
  authorization_reference String?            @db.VarChar(255)
  paid_at                 DateTime?          @db.Timestamptz(6)
  failure_reason          String?
  created_at              DateTime           @default(now()) @db.Timestamptz(6)
  updated_at              DateTime           @default(now()) @db.Timestamptz(6)
  payment_attempts        payment_attempts[]
  payment_events          payment_events[]

  @@schema("payments")
}

enum product_status {
  DRAFT
  ACTIVE
  ARCHIVED
  OUT_OF_STOCK

  @@schema("catalog")
}

enum product_type {
  READY_MADE
  MADE_TO_ORDER
  CUSTOM

  @@schema("catalog")
}

enum customer_status {
  ACTIVE
  INACTIVE
  BLOCKED

  @@schema("customer")
}
